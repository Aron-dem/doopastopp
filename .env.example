# Vercel Environment Variables Example
# Copy these to your Vercel project settings

# Ad Links
VITE_AD_LINK_1=https://example.com/app-download
VITE_AD_LINK_2=https://example.com/wellness-course
VITE_AD_LINK_3=https://example.com/community-join

# Questions Data (Base64 Encoded JSON)
# This allows keeping questions as "secrets" in Vercel
# Format: [{ "id": 1, "section": 1, "reversed": false, "section.ar": "...", "section.en": "...", "text.ar": "...", "text.en": "..." }]
VITE_QUESTIONS_
